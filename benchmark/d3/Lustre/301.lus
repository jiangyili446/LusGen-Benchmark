
node max2(a : int; b : int) returns (res : int);
let
    res = if a > b then a else b;
tel

node min2(a : int; b : int) returns (res : int);
let
    res = if a < b then a else b;
tel

-- 计算三个整数中的最大值
node max3(a : int; b : int; c : int) returns (res : int);
let
    res = max2(max2(a, b), c);
tel

node min3(a : int; b : int; c : int) returns (res : int);
let
    res = min2(min2(a, b), c);
tel

node calculateOptimalMeetingPointDistance(x1 : int; x2 : int; x3 : int) returns (out : int);
var max_val, min_val: int;
let
    max_val = max3(x1, x2, x3);
    min_val = min3(x1, x2, x3);
    out = max_val - min_val;
tel
